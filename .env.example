# =============================================================================
# Drincup Cafe -- environment variables
#
# Copy to .env.local and fill in. .env.local is gitignored; never commit real
# keys. NEXT_PUBLIC_* values are compiled into the browser bundle, so nothing
# secret may ever use that prefix.
# =============================================================================

# ---- Supabase ---------------------------------------------------------------
# For local development these are printed by `npm run db:start`.
# For production, Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses Row Level Security. Server-side only. Never expose this to the
# browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---- App --------------------------------------------------------------------
# Used for absolute URLs in metadata, emails and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Stripe (Phase 4) -------------------------------------------------------
# Test mode keys only until the cafe is ready to go live (sk_test_ / pk_test_).
# Dashboard -> Developers -> API keys.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Printed by `npm run stripe:listen` (see README, "Payments (Stripe)"), which
# runs the Stripe CLI with the key above, so it listens to the same account
# (a plain `stripe login` may be logged in to a different one). Check the
# whole setup with `npm run stripe:doctor`.
# In production: the signing secret of the webhook endpoint you create in the
# Stripe dashboard for https://<domain>/api/webhooks/stripe.
STRIPE_WEBHOOK_SECRET=

# ---- Scheduled jobs (Phase 4) -----------------------------------------------
# Shared secret for /api/cron/expire-orders. Vercel Cron sends it as
# "Authorization: Bearer <CRON_SECRET>" automatically once it is set in the
# project's environment variables. Any long random string, e.g.
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }))
CRON_SECRET=

# ---- Email (Phase 5) --------------------------------------------------------
# Leave RESEND_API_KEY empty locally: order emails then go to the local
# Supabase stack's Mailpit (http://127.0.0.1:54324), no account needed.
# In production, set it to a Resend API key and emails go through Resend.
RESEND_API_KEY=
# Sender for order receipts and catering updates. In production the domain
# must be verified in Resend.
EMAIL_FROM="Drincup Cafe <orders@example.com>"
# Optional: where Mailpit listens (default http://127.0.0.1:54324).
# MAILPIT_URL=

# ---- Local testing ----------------------------------------------------------
# true = treat every location as open 24 hours, every day (hours and closures
# ignored; pause, sold out and pop-up event windows still apply), with a
# banner on every page. For testing from outside Hawaii, where it is often
# night in Honolulu. Honoured ONLY on a dev server whose
# NEXT_PUBLIC_SUPABASE_URL is local (127.0.0.1, localhost, private LAN IP);
# ignored, with a server warning, anywhere else. Never set it in production.
TEST_STORE_ALWAYS_OPEN=false
